      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "market-header",
        "market-title",
        "market-current",
        "market-fair",
        "market-thesis",
        "market-risk"
      ]
    },
    "market-header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "market-label",
        "market-badges"
      ]
    },
