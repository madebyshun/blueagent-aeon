      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge-high-market",
        "badge-edge-market"
      ]
    },
    "badge-high-market": {
      "type": "Badge",
      "props": {
        "text": "HIGH",
        "variant": "destructive"
      }
    },
    "badge-edge-market": {
      "type": "Badge",
      "props": {
        "text": "edge 21pp",
        "variant": "secondary"
      }
    },
    "market-title": {
      "type": "Text",
      "props": {
        "text": "2026 Balance of Power: R Senate, D House",
        "variant": "lead"
      }
    },
    "market-current": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "market-odds",
        "market-meta"
      ]
