{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Daily Pick — 2026-10-20"
      },
      "children": [
        "wld-section",
        "separator-1",
        "market-section",
        "separator-2",
        "footer"
      ]
    },
    "wld-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "wld-header",
        "wld-price-data",
        "wld-breakdown",
        "wld-catalyst",
        "wld-risk",
        "wld-comparison"
      ]
    },
    "wld-header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "wld-title",
        "wld-badges"
      ]
    },
    "wld-title": {
      "type": "Heading",
      "props": {
        "text": "WLD",
        "level": "h2"
      }
    },
    "wld-badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge-high-wld",
        "badge-signal-wld"
      ]
    },
    "badge-high-wld": {
      "type": "Badge",
      "props": {
        "text": "HIGH",
        "variant": "destructive"
      }
    },
    "badge-signal-wld": {
      "type": "Badge",
      "props": {
        "text": "signal 11/10",
        "variant": "secondary"
      }
    },
    "wld-price-data": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "stat-wld-price",
        "stat-wld-24h",
        "stat-wld-7d",
        "stat-wld-mcap",
        "stat-wld-vol",
        "stat-wld-vol-ratio"
      ]
    },
    "stat-wld-price": {
      "type": "Stat",
      "props": {
        "label": "Price",
        "value": "$0.56"
      }
    },
    "stat-wld-24h": {
      "type": "Stat",
      "props": {
        "label": "24h change",
        "value": "±11.3%",
        "trend": "neutral"
      }
    },
    "stat-wld-7d": {
      "type": "Stat",
      "props": {
        "label": "7d change",
        "value": "±15.0%",
        "trend": "neutral"
      }
    },
    "stat-wld-mcap": {
      "type": "Stat",
      "props": {
        "label": "mcap",
        "value": "$2.15B"
      }
    },
    "stat-wld-vol": {
      "type": "Stat",
      "props": {
        "label": "24h volume",
        "value": "$510M"
      }
    },
    "stat-wld-vol-ratio": {
      "type": "Stat",
      "props": {
        "label": "vol/mcap",
        "value": "0.24"
      }
