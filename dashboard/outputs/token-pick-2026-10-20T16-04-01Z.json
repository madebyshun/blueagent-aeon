      "type": "Text",
      "props": {
        "text": "Score breakdown: [24h>0+1, 7d>0+1, both>5%+2, trending#3+2, vol/mcap≥0.20+3, RS vs BTC/ETH+2] = 11/10",
        "variant": "caption"
      }
    },
    "wld-catalyst": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "catalyst-label",
        "catalyst-content"
      ]
    },
