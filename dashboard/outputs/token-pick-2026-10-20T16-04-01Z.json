      "children": [
        "progress-yes",
        "progress-no"
      ]
    },
    "progress-yes": {
      "type": "Progress",
      "props": {
        "label": "Current YES",
        "value": 28.5,
        "max": 100
      }
    },
    "progress-no": {
      "type": "Progress",
      "props": {
        "label": "Current NO",
        "value": 71.5,
        "max": 100
      }
    },
    "market-meta": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "stat-market-vol",
        "stat-market-resolves"
      ]
    },
    "stat-market-vol": {
      "type": "Stat",
      "props": {
        "label": "24h volume",
        "value": "$452k"
      }
    },
    "stat-market-resolves": {
      "type": "Stat",
      "props": {
        "label": "Resolves",
        "value": "Nov 4, 2026"
      }
    },
    "market-fair": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "progress-fair-yes",
        "fair-yes-inputs"
      ]
    },
    "progress-fair-yes": {
      "type": "Progress",
      "props": {
        "label": "Fair YES",
        "value": 50,
        "max": 100
      }
    },
    "fair-yes-inputs": {
      "type": "Text",
      "props": {
        "text": "inputs: DDHQ Oct 12 D-House 76%, Republican Senate map advantage ~68%; 0.76×0.68≈52%",
        "variant": "caption"
      }
    },
    "market-thesis": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "thesis-label",
        "thesis-content"
      ]
    },
    "thesis-label": {
      "type": "Heading",
      "props": {
        "text": "Thesis",
        "level": "h4"
      }
    },
    "thesis-content": {
      "type": "Text",
      "props": {
        "text": "Market back-calcs R-Senate at ~37¢ (28.5¢ ÷ 0.76), but Republicans hold a structural advantage defending far fewer seats — the split outcome is badly underpriced."
      }
    },
    "market-risk": {
      "type": "Alert",
      "props": {
        "title": "Risk",
        "message": "A strong Dem wave sweeps both chambers, or House polling miss flips back Republican — either collapses the YES.",
        "type": "warning"
      }
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "footer": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "sources",
        "disclaimer"
      ]
    },
    "sources": {
      "type": "Text",
      "props": {
        "text": "sources: cg=ok, dex=partial, poly=ok",
        "variant": "caption"
      }
    },
    "disclaimer": {
      "type": "Text",
      "props": {
        "text": "not financial advice — pattern-matching only",
        "variant": "muted"
      }
    }
  }
}
