{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Daily Pick — 2026-10-13",
        "description": "token-pick"
      },
      "children": [
        "token-section",
        "sep1",
        "market-section",
        "sep2",
        "footer-section"
      ]
    },
    "token-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "token-header",
        "price-metrics",
        "score-breakdown",
        "catalyst-block",
        "token-risk"
      ]
    },
    "token-header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "token-title",
        "token-badge",
        "signal-stat"
      ]
    },
    "token-title": {
      "type": "Heading",
      "props": {
        "text": "Token: TIA",
        "level": "h2"
      }
    },
    "token-badge": {
      "type": "Badge",
      "props": {
        "text": "HIGH",
        "variant": "secondary"
      }
    },
    "signal-stat": {
      "type": "Stat",
      "props": {
        "label": "Signal",
        "value": "9/10"
      }
    },
    "price-metrics": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "price-line",
        "market-line"
      ]
    },
    "price-line": {
      "type": "Text",
      "props": {
        "text": "Price: $0.576 (±5.2% 24h / ±19.7% 7d)",
        "variant": "body"
      }
    },
    "market-line": {
      "type": "Text",
      "props": {
        "text": "mcap $565M | vol $149M (vol/mcap 0.26)",
        "variant": "caption"
      }
    },
    "score-breakdown": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "score-label",
        "score-formula"
      ]
    },
    "score-label": {
      "type": "Heading",
      "props": {
        "text": "Score Breakdown",
        "level": "h4"
      }
