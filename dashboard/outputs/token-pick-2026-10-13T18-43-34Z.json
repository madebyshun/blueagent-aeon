      "type": "Alert",
      "props": {
        "title": "Risk",
        "message": "October CPI/PCE data (not yet available) could confirm inflation cooling and validate the market's hold bias",
        "type": "warning"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "footer-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "sources-label",
        "sources-text",
        "disclaimer-text"
