      "type": "Text",
      "props": {
        "text": "Market has overcorrected toward hold (79.5%) — the same hiking cycle that drove September's first hike since 2023 makes October a live call, not a formality. Buying YES on +25bps at 19.5¢.",
        "variant": "body"
      }
    },
    "thesis-action": {
      "type": "Badge",
      "props": {
        "text": "Action: Buy YES at 19.5¢",
        "variant": "outline"
      }
    },
