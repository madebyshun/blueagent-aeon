    "market-vol-text": {
      "type": "Text",
      "props": {
        "text": "24h vol $353K",
        "variant": "caption"
      }
    },
    "market-resolve-text": {
      "type": "Text",
      "props": {
        "text": "resolves: 2026-10-29",
        "variant": "caption"
      }
    },
