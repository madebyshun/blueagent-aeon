      }
    },
    "token-risk": {
      "type": "Alert",
      "props": {
        "title": "Risk",
        "message": "No confirmed fresh catalyst for the 7d run; still 97%+ below Feb 2024 all-time high ($20.85) with heavy overhead supply at every level",
        "type": "warning"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "market-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
