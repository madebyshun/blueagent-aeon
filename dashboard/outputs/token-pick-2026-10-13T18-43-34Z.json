    "score-formula": {
      "type": "Text",
      "props": {
        "text": "[24h>0 +1, 7d>0 +1, both>5% +2, vol/mcap≥0.20 +3, RS vs BTC/ETH +2] = 9/10",
        "variant": "caption"
      }
    },
    "catalyst-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "catalyst-label",
        "catalyst-text"
      ]
