      "children": [
        "market-header",
        "market-odds-row",
        "market-volume",
        "market-resolves",
        "market-fair-yes",
        "market-thesis",
        "market-risk"
      ]
    },
    "market-header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "market-title",
        "badge-medium-market",
        "badge-edge"
      ]
