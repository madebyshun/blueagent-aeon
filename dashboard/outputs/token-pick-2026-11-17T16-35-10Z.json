{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Daily Pick — 2026-11-12"
      },
      "children": [
        "stack-main"
      ]
    },
    "stack-main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "token-section",
        "separator-1",
        "market-section",
        "footer-section"
      ]
    },
    "token-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "token-header",
        "token-stats",
        "token-score",
        "token-catalyst",
        "token-risk",
        "token-recent"
      ]
    },
    "token-header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "token-name",
        "badge-medium",
        "badge-signal"
      ]
    },
    "token-name": {
      "type": "Heading",
      "props": {
        "text": "Token: PENGU",
        "level": "h2"
      }
    },
    "badge-medium": {
      "type": "Badge",
      "props": {
        "text": "MEDIUM",
        "variant": "secondary"
      }
    },
    "badge-signal": {
      "type": "Badge",
      "props": {
        "text": "signal 6/10",
        "variant": "outline"
      }
    },
    "token-stats": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "md"
      },
      "children": [
        "stat-price",
        "stat-mcap",
        "stat-volume",
        "stat-vol-mcap"
      ]
    },
    "stat-price": {
      "type": "Stat",
      "props": {
        "label": "Price",
        "value": "$0.0061",
        "delta": "-3.6% 24h / -4.4% 7d",
        "trend": "down"
      }
    },
    "stat-mcap": {
      "type": "Stat",
      "props": {
        "label": "Market Cap",
        "value": "$384M"
      }
    },
    "stat-volume": {
      "type": "Stat",
      "props": {
        "label": "Volume",
        "value": "$61.4M"
      }
    },
    "stat-vol-mcap": {
      "type": "Stat",
      "props": {
        "label": "Vol/Mcap",
        "value": "0.16"
      }
    },
    "token-score": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "score-label",
        "score-progress",
        "score-breakdown"
      ]
    },
    "score-label": {
      "type": "Text",
      "props": {
        "text": "Score Breakdown",
        "variant": "lead"
      }
    },
    "score-progress": {
      "type": "Progress",
      "props": {
        "value": 6,
        "max": 10,
        "label": "6/10"
      }
    },
    "score-breakdown": {
      "type": "Text",
      "props": {
        "text": "trending+2, vol/mcap+2, RS vs BTC/ETH+2",
        "variant": "caption"
      }
    },
    "token-catalyst": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "catalyst-label",
        "catalyst-text"
      ]
    },
    "catalyst-label": {
      "type": "Text",
      "props": {
        "text": "Catalyst:",
        "variant": "lead"
      }
    },
    "catalyst-text": {
      "type": "Text",
      "props": {
        "text": "Canary Capital PENGU ETF application pending SEC approval since 2025 — structural bid floor keeping token resilient vs peers during broad crypto selloff; ETF would be first US fund to hold real NFTs",
        "variant": "body"
      }
    },
    "token-risk": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "risk-label-token",
        "risk-text-token"
      ]
    },
    "risk-label-token": {
      "type": "Text",
      "props": {
        "text": "Risk:",
        "variant": "lead"
      }
