        "variant": "body"
      }
    },
    "market-risk": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "risk-label-market",
        "risk-text-market"
      ]
    },
    "risk-label-market": {
      "type": "Text",
      "props": {
        "text": "Risk:",
        "variant": "lead"
      }
